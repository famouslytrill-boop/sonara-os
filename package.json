{
  "name": "sonara-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "main": "server.js",
  "scripts": {
    "vercel-build": "pnpm run build",
    "gen:tenant-tables": "node scripts/generate-tenant-scoped-tables.cjs",
    "gen:member-policies": "node scripts/generate-member-read-policies.cjs",
    "gen:catalog-sync": "node scripts/generate-catalog-sync-migration.cjs",
    "gen:catalog-doc": "node scripts/generate-product-catalog-doc.mjs",
    "verify:member-policies": "node scripts/generate-member-read-policies.cjs --check",
    "verify:catalog-sync": "node scripts/generate-catalog-sync-migration.cjs --check",
    "verify:catalog-doc": "node scripts/generate-product-catalog-doc.mjs --check",
    "report:user-scoped": "node scripts/report-user-scoped-readiness.cjs",
    "verify:tenant-tables": "node scripts/generate-tenant-scoped-tables.cjs --check",
    "db:patch-triggers": "node scripts/patch-idempotent-migration-triggers.cjs",
    "db:push": "node scripts/require-supabase-cli.cjs && pnpm run db:patch-triggers && supabase db push",
    "db:push:all": "node scripts/require-supabase-cli.cjs && pnpm run db:patch-triggers && supabase db push --include-all",
    "test": "mocha --pass-with-no-tests",
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "build": "node --check server.js && node -e \"require('./server')\"",
    "lint": "eslint --max-warnings=0 server.js api routes lib scripts tests public examples tools --ignore-pattern \"archive/**\" --ignore-pattern \"**/node_modules/**\" --ignore-pattern \"**/.next/**\"",
    "typecheck": "node scripts/typecheck.mjs",
    "scan:client-secrets": "node scripts/client-secret-scan.cjs",
    "smoke:live": "node scripts/smoke-live-routes.mjs",
    "smoke:routes": "node scripts/smoke-routes.cjs",
    "verify:agent-sync": "node scripts/verify-agent-development-sync.mjs",
    "verify:customer-ready": "node scripts/verify-customer-ready-production-experience.mjs",
    "verify:config": "node scripts/verify-launch-config.mjs && node scripts/verify-route-registry.cjs && pnpm run verify:agent-sync && pnpm run verify:customer-ready",
    "verify:api": "node scripts/verify-openapi-contract.mjs",
    "verify:supabase-contract": "node scripts/verify-supabase-contract.mjs",
    "verify:db": "node scripts/verify-production-schema.mjs && pnpm run verify:supabase-contract",
    "verify:production-supabase": "node scripts/verify-production-supabase.mjs",
    "verify:open-source": "node scripts/verify-open-source-registry.mjs",
    "verify:product-map": "node scripts/generate-product-integration-map.mjs --check",
    "verify:handoff": "node scripts/generate-handoff-prompt.mjs --check",
    "verify:definer-exposure": "node scripts/report-security-definer-exposure.mjs --check",
    "verify:unreferenced-modules": "node scripts/report-unreferenced-modules.mjs --check",
    "report:orphan-tables": "node scripts/report-orphan-tables.mjs",
    "verify:orphan-tables": "node scripts/report-orphan-tables.mjs --check",
    "verify:selected-columns": "node scripts/report-unused-selected-columns.mjs --check",
    "report:selected-columns": "node scripts/report-unused-selected-columns.mjs",
    "verify:open-source:network": "node scripts/verify-open-source-registry.mjs --network",
    "verify:launch": "pnpm run build && pnpm run test && pnpm run scan:client-secrets && pnpm run lint && pnpm run smoke:routes && pnpm run verify:db && pnpm run verify:env && pnpm run verify:config && pnpm run verify:api && pnpm run verify:stripe && pnpm run verify:tenant-tables && pnpm run verify:member-policies && pnpm run verify:applied-migrations && pnpm run verify:catalog-sync && pnpm run verify:catalog-doc && pnpm run verify:open-source && pnpm run verify:product-map && pnpm run verify:handoff && pnpm run verify:definer-exposure && pnpm run verify:unreferenced-modules && pnpm run verify:orphan-tables && pnpm run verify:selected-columns && pnpm run verify:stale-claims && pnpm run verify:doc-counts && pnpm run verify:research-copy && pnpm run verify:contrast && pnpm run verify:source-licence && pnpm run verify:growth-copy && pnpm run verify:csp && pnpm run verify:margins",
    "verify:all": "pnpm run verify:launch",
    "verify:postdeploy": "node scripts/verify-postdeploy.mjs",
    "report:stale-claims": "node scripts/report-stale-claims.mjs",
    "verify:stale-claims": "node scripts/report-stale-claims.mjs --check",
    "verify:research-copy": "node scripts/check-research-lab-public-copy.mjs",
    "verify:contrast": "node scripts/verify-colour-contrast.mjs",
    "enable:leaked-password": "node scripts/enable-leaked-password-protection.mjs",
    "verify:doc-counts": "node scripts/verify-doc-counts.mjs --check",
    "verify:source-licence": "node scripts/verify-source-licence.mjs",
    "verify:growth-copy": "node scripts/check-growth-studio-copy.mjs",
    "verify:csp": "node scripts/verify-content-security-policy.mjs",
    "verify:margins": "node scripts/verify-paid-capability-margins.mjs",
    "verify:env": "node scripts/verify-env.mjs",
    "verify:stripe": "node scripts/verify-stripe-env.mjs",
    "workers:smoke": "echo Optional Creator Studio GPU workers and Growth Studio automation workers are disabled by default and use reviewed contracts when configured",
    "test:security": "pnpm run scan:client-secrets",
    "test:docs": "node scripts/check-doc-links.mjs",
    "verify:member-read-access": "node scripts/verify-member-read-access.mjs",
    "verify:applied-migrations": "node scripts/verify-applied-migrations.mjs",
    "gen:applied-migrations": "node scripts/verify-applied-migrations.mjs --write"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@vercel/node": "^5.8.26",
    "eslint": "^10.7.0",
    "mocha": "^11.7.6",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
