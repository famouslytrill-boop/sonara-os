{
  "name": "signal-os",
  "version": "0.1.0",
  "private": true,
  "description": "Clean Signal OS workspace scaffolded from the phased gate.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs && tsc --noEmit",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run --pool=threads --no-isolate",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
