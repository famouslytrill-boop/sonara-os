  "cards": [
    {
      "dot": "cyan",
      "title": "Authority",
      "items": [
        "The browser never owns tenant or administrative authority.",
        "Agent memory, emotion, and presentation layers cannot widen tool permissions.",
        "Provider Gateway remains the model/provider boundary."
      ]
    },
    {
      "dot": "rose",
      "title": "Tenant isolation",
      "items": [
        "Session-derived organization context drives tenant-scoped queries.",
        "RLS remains a second database boundary.",
        "Caller-supplied organization or role hints are adversarial input, not authority."
      ]
    },
    {
      "dot": "emerald",
      "title": "Release evidence",
      "items": [
        "Architecture validation is deterministic and pinned in CI.",
        "Security tests produce machine-readable receipts.",
        "Deployment is downstream of the evidence gate, not the source of truth for it."
      ]
    }
  ]
