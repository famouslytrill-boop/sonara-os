# Local-only inputs for docker-compose.open-source.yml.
# setup-open-source-local.mjs copies this to .env.open-source.local and replaces
# GENERATE_ON_FIRST_RUN values with strong random values. Never deploy or commit
# the generated file.

OLLAMA_IMAGE=ollama/ollama:latest
LANGFLOW_IMAGE=langflowai/langflow:latest
CRAWL4AI_IMAGE=unclecode/crawl4ai:latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

LANGFLOW_SUPERUSER=sonara-local-admin
LANGFLOW_SUPERUSER_PASSWORD=GENERATE_ON_FIRST_RUN
LANGFLOW_SECRET_KEY=GENERATE_ON_FIRST_RUN
LANGFLOW_API_KEY=GENERATE_ON_FIRST_RUN
OPEN_WEBUI_SECRET_KEY=GENERATE_ON_FIRST_RUN
