# SONARA Industries SaaS launch env template.
# Keep real values in local .env, Vercel, Supabase, Stripe, Resend, or a password manager. Never commit real secrets.

NODE_ENV=development
PORT=3000

# Public deployment URL
NEXT_PUBLIC_SITE_URL=
PUBLIC_SITE_URL=
APP_URL=

# Supabase auth/database
# NEXT_PUBLIC_SUPABASE_URL must be the exact Project Settings -> API Project URL.
# Do not infer it from a project name and do not place service-role values in public variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BUSINESS_BUILDER_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_BUILDER_ONETIME=
STRIPE_PRICE_ID_CREATOR_STUDIO_MONTHLY=
STRIPE_PRICE_ID_GROWTH_STUDIO_MONTHLY=

# Backward-compatible Stripe aliases used by older deploys
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
# The breadth plans. Create the Stripe prices, then set these; until then the
# plans render as not open for checkout, which is true rather than broken.
STRIPE_PRICE_WORKSPACE_MONTHLY=
STRIPE_PRICE_ALL_THREE_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
# Annual billing. Two months free against the monthly price above. Each plan
# stays off the pricing page until its price exists here and in Stripe.
STRIPE_PRICE_WORKSPACE_ANNUAL=
STRIPE_PRICE_ALL_THREE_ANNUAL=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_BUSINESS_BUILDER_ONE_TIME=

# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_TO_EMAIL=
CONTACT_TO_EMAIL=

# Founder/admin access. Comma-separated emails.
FOUNDER_EMAILS=
ADMIN_EMAILS=
ADMIN_EMAIL=

# Deferred until Google OAuth provider is configured
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional AI gateway (OmniRoute). Operator/development use only.
# The public site never depends on these. Never route customer data through
# a local AI gateway and never expose these values to the browser.
# See docs/infrastructure/OPTIONAL_AI_GATEWAY.md
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
# Legacy aliases still honored by the readiness detector
SONARA_AI_GATEWAY_URL=
SONARA_AI_GATEWAY_KEY=

# Governed AI service adapters. Every adapter is disabled by default.
# Base URLs and credentials are read server-side only. Readiness probes never
# execute prompts, flows, tools, jobs, or customer actions.
SONARA_AI_INTEGRATION_PROBE_TIMEOUT_MS=1200

OPENCLAW_ENABLED=false
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

N8N_ENABLED=false
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434

LANGFLOW_ENABLED=false
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=

DIFY_ENABLED=false
DIFY_BASE_URL=http://127.0.0.1:5001/v1
DIFY_API_KEY=

OPEN_WEBUI_ENABLED=false
OPEN_WEBUI_BASE_URL=http://127.0.0.1:3001
OPEN_WEBUI_API_KEY=

RAGFLOW_ENABLED=false
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=

CREWAI_ENABLED=false
CREWAI_WORKER_URL=http://127.0.0.1:8001
CREWAI_WORKER_TOKEN=

# Governed Hugging Face Hub metadata integration. Disabled by default.
# Enabling performs one bounded read-only metadata probe. It does not download
# models, ingest datasets, train, or run inference. HF_TOKEN is server-only.
HUGGINGFACE_HUB_ENABLED=false
HUGGINGFACE_HUB_BASE_URL=https://huggingface.co
HF_TOKEN=
SONARA_HF_PROBE_TIMEOUT_MS=1800

# Optional local-compose bootstrap secrets. Set strong, unique local values
# before starting the corresponding profile; never deploy these placeholders.
N8N_ENCRYPTION_KEY=
LANGFLOW_SUPERUSER=sonara-local-admin
LANGFLOW_SUPERUSER_PASSWORD=
LANGFLOW_SECRET_KEY=
OPEN_WEBUI_SECRET_KEY=
OPEN_WEBUI_ENABLE_SIGNUP=False

# Optional legacy/non-SaaS values preserved for compatibility with scripts/docs
DATABASE_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
# Read by nothing today. Checkout is server-side: server.js creates the Stripe
# session and redirects, so no publishable key reaches a browser. Kept as the
# name to use if browser-side Stripe.js is ever introduced.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
ENVIRONMENT=development
SONARA_CRON_SECRET=
SONARA_PROVIDER_TIMEOUT_MS=6000

# Turns the leaked-password warning into a gate.
#
# The application already refuses breached passwords itself at signup and reset
# (lib/sonara-leaked-password.cjs). This variable is about the Supabase dashboard
# setting, which covers every path Supabase Auth serves rather than only ours.
#
# Until it is set, the deploy prints a warning and passes either way -- so a
# green deploy tells you nothing about whether the toggle is on. Set it to true
# after enabling Authentication -> Providers -> Password in the dashboard.
# docs/owner/OWNER-STEPS.md item 2.
SONARA_REQUIRE_LEAKED_PASSWORD_PROTECTION=false

# Development only. Never true in production.
#
# Accepts an organization_id straight from the request body with no membership
# check, so while it is on any request can name any organization. The code
# refuses it in production regardless of this value (NODE_ENV and VERCEL_ENV are
# both checked in routes/sonara-last9-routes.cjs), so this is the second lock
# rather than the only one.
SONARA_ALLOW_MANUAL_ORG_ID=false

# Browser-to-browser calling. Optional; unset means the call page says so.
#
# SONARA_STUN_URLS is one or more comma-separated stun: addresses. It is what
# lets two browsers on different networks find each other, and it carries no
# audio -- a STUN server is asked "what is my public address" and answers.
#
# There is deliberately no default. A public STUN address hardcoded here would
# make calling depend on somebody else's free tier, and a call feature that
# stops working on a day nobody here chose is worse than one that says it is not
# set up. Without it, calls still connect between two devices on the same
# network.
SONARA_STUN_URLS=

# A relay, for the roughly one connection in six that cannot go direct. Set both
# or neither. The relay does carry the audio, so it is the one part of calling
# with a running cost -- a fixed monthly server rather than a per-minute bill.
#
# SONARA_TURN_SECRET is server-only and must never be rendered into a page. It
# signs the short-lived credentials browsers are given; those expire within the
# hour, and this does not expire at all.
SONARA_TURN_URL=
SONARA_TURN_SECRET=
# Turns "no PostgreSQL here" from a notice into a failure.
#
# scripts/verify-migration-replay.mjs is the only check in this repository that
# EXECUTES the migrations rather than reading them as text. Without PostgreSQL
# it cannot replay anything, and it says so loudly and passes -- a contributor
# with no local database should not be blocked.
#
# CI sets this to 1, because a check whose skip path is the one that always runs
# is not a check. Set it locally too if you want the same guarantee; you will
# need PostgreSQL 14 or later on PATH. It never reaches a customer.
SONARA_MIGRATION_REPLAY_REQUIRED=

# The key two-step sign-in rests on. Server-only, and never rendered into a page.
#
# Two things are derived from it, under separate labels: the key that seals TOTP
# shared secrets and parked sessions before they are written, and the pepper
# recovery-code hashes are taken under. Both live outside the database on
# purpose -- reading the tables then gives an attacker ciphertext and peppered
# digests rather than every second factor on the system.
#
# Generate with: openssl rand -hex 32
#
# Without it, two-step sign-in refuses to switch on and says so. It does not
# fall back to storing secrets in the clear: a second factor that quietly
# degrades is one that tells everybody they are protected when they are not.
#
# Changing it makes every enrolled factor and every recovery code unreadable,
# so people would have to enrol again. Set it once, keep it.
SONARA_TOTP_KEY=
